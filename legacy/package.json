{
  "name": "legacy-property-hub-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute legacy_property_hub_db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute legacy_property_hub_db --remote --file=./schema.sql",
    "test:email": "node scripts/send-test-email.js"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "stripe": "^17.3.1",
    "pdf-lib": "^1.17.1"
  },
  "allowScripts": {
    "esbuild@0.17.19": true,
    "fsevents@2.3.3": true,
    "sharp@0.33.5": true,
    "workerd@1.20250718.0": true
  }
}
